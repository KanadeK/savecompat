{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/KanadeK/savecompat/blob/main/schema/savecompat.config.schema.json",
  "title": "SaveCompat configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["latestVersion", "fixtures", "schemas", "migrations"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "latestVersion": {
      "type": "string",
      "minLength": 1
    },
    "versionPath": {
      "type": "string",
      "pattern": "^(/.*)?$",
      "default": "/saveVersion"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migrationReference"
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preserveRule"
      }
    },
    "arrayKeys": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "validateSource": {
      "type": "boolean",
      "default": true
    }
  },
  "$defs": {
    "migrationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "file"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preserveRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "from", "to"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "to": {
          "type": "string",
          "pattern": "^(/.*)?$"
        },
        "fromVersion": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
